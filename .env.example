# Respaldo: los datos de la tienda (WhatsApp, dirección, etc.) se editan desde la pantalla "Tienda online" del sistema POS.
# los mismos que ya usa el sistema POS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WhatsApp que recibe los pedidos: solo números, con código de país (Argentina: 549 + código de área + número)
NEXT_PUBLIC_WHATSAPP=5493584000000
NEXT_PUBLIC_NOMBRE_TIENDA=Nuez Co
NEXT_PUBLIC_DIRECCION_SUCURSAL=Dirección de la sucursal
NEXT_PUBLIC_HORARIO=Lunes a sábado de 9 a 20 hs
# Monto desde el cual el envío es gratis (solo el número, sin $ ni puntos). Dejalo en 0 para no mostrar.
NEXT_PUBLIC_ENVIO_GRATIS_DESDE=0
